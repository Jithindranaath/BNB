# Copy to the repo root as .env  ->  cp infra/.env.example .env
# NEVER commit .env. No private key ever goes in the DB, logs, or an LLM prompt (rule S3).
# Every variable the project reads is named here. Values are examples or blank on purpose.

# ---------------------------------------------------------------------------
# Local infra (docker compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=proofstand
POSTGRES_PASSWORD=proofstand
POSTGRES_DB=proofstand
POSTGRES_PORT=5432
REDIS_PORT=6379
ANVIL_PORT=8545
HUMMINGBOT_API_PORT=8000
GATEWAY_PORT=15888

# Assembled from the above for app code
DATABASE_URL=postgresql+psycopg://proofstand:proofstand@localhost:5432/proofstand
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Chain access  (BSC mainnet only; testnet only for contract dry runs)
# ---------------------------------------------------------------------------
# PublicNode works with no key. Nodereal / Ankr give higher limits with a key.
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_RPC_URL_FALLBACK=https://bsc-dataseed.bnbchain.org
BSC_CHAIN_ID=56
# Local fork target for the sentry harness (T-030)
FORK_RPC_URL=https://bsc-dataseed1.bnbchain.org

# ---------------------------------------------------------------------------
# External data APIs  (see architecture.md §5)
# ---------------------------------------------------------------------------
# The Graph — free key from https://thegraph.com/studio/apikeys/  (PCS v3 subgraph)
GRAPH_API_KEY=
# BscScan — free key from https://bscscan.com/myapikey  (verified source, contract age)
BSCSCAN_API_KEY=
# Binance klines + DefiLlama need no key.
BINANCE_BASE_URL=https://api.binance.com
DEFILLAMA_BASE_URL=https://yields.llama.fi

# ---------------------------------------------------------------------------
# Orchestrator
# ---------------------------------------------------------------------------
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8080
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Receipt anchoring (T-062) — a low-value key that ONLY calls ReceiptAnchor.anchor().
# Leave blank until that task. Never reuse a funded personal key here.
# ---------------------------------------------------------------------------
ANCHOR_PRIVATE_KEY=
RECEIPT_ANCHOR_ADDRESS=

# ---------------------------------------------------------------------------
# Tier 2 live execution (session-key scoped; see spec.md §S2, architecture.md §11)
# Not used until the trading agents go live. Blank by default.
# ---------------------------------------------------------------------------
SESSION_KEY_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Front end
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:8080
